#!/bin/bash

# Каталог для логов скрипта
LOG_DIR="/var/log/ffmpeg"

# Файл для логов скрипта
SCRIPT_LOG="${LOG_DIR}/ffmpeg_serviio.log"

# Каталог транскодирования SERVIIO
SERVIIO_CACHE_DIR="/fast/cache/serviio/Serviio"

# Результат успешного транскодирования
CACHE_DIR="/fast/cache/converted"

# Тег для syslog
LOGGER_TAG="ffmpeg_serviio"

# Уровень детализации файлового лога: INFO (по умолчанию) или DEBUG.
# INFO: только ключевые события — запуск, уровень каскада, HIT/MISS, ошибки.
# DEBUG: плюс весь подробный вывод — команды, размеры/даты кэша, разделители.
# Переопределение без правки скрипта: FFMPEG_SERVIIO_LOG_LEVEL=DEBUG ffmpeg ...
LOG_LEVEL="${FFMPEG_SERVIIO_LOG_LEVEL:-INFO}"
LOG_LEVEL="${LOG_LEVEL^^}"

USER_ID=$(id -u)
USER_NAME=$(id -un)
GROUP_ID=$(id -g)
GROUP_NAME=$(id -gn)

PARENT_LOG_DIR=$(dirname "${LOG_DIR}")
PARENT_CACHE_DIR=$(dirname "${CACHE_DIR}")
PARENT_SERVIIO_CACHE_DIR=$(dirname "${SERVIIO_CACHE_DIR}")

NEED_ROOT=

# Функции для логирования в syslog
log_info()    { logger -t "$LOGGER_TAG" -p user.info "$1"; }
log_warning() { logger -t "$LOGGER_TAG" -p user.warning "$1"; }
log_error()   { logger -t "$LOGGER_TAG" -p user.err "$1"; }
log_debug()   { logger -t "$LOGGER_TAG" -p user.debug "$1"; }

# Файловый лог с уровнями: log_file INFO|DEBUG "строка1" "строка2" ...
# INFO-строки пишутся всегда, DEBUG-строки — только при LOG_LEVEL=DEBUG.
log_file() {
    local req="$1"
    shift
    if [ "$req" = "DEBUG" ] && [ "$LOG_LEVEL" != "DEBUG" ]; then
        return 0
    fi
    local line
    for line in "$@"; do
        echo "$line" >> "$SCRIPT_LOG"
    done
}

# Создаем директорию для логов если не существует
if [ ! -d "${LOG_DIR}" ]; then
    if [ -w "${PARENT_LOG_DIR}" ]; then
        mkdir -p "${LOG_DIR}"
        log_info "Created log directory: ${LOG_DIR}"
    else
        NEED_ROOT=1
        log_warning "Cannot create log directory ${LOG_DIR} - need root"
    fi
fi

# Создаем директорию для результата транскодирования если не существует
if [ ! -d "${CACHE_DIR}" ]; then
    if [ -w "${PARENT_CACHE_DIR}" ]; then
        mkdir -p "${CACHE_DIR}"
        log_info "Created cache directory: ${CACHE_DIR}"
    else
        NEED_ROOT=1
        log_warning "Cannot create cache directory ${CACHE_DIR} - need root"
    fi
fi

if [ -n "${NEED_ROOT}" ]; then
    log_error "Insufficient permissions to create directories"
    echo "Create the necessary directories from root:"
    echo "mkdir -p ${LOG_DIR}"
    echo "mkdir -p ${CACHE_DIR}"
    echo "chown ${USER_NAME}:${GROUP_NAME} ${LOG_DIR}"
    echo "chown ${USER_NAME}:${GROUP_NAME} ${CACHE_DIR}"
    echo "Bye!"
    exit 100
fi

# Логируем запуск
log_info "=== ffmpeg_serviio started (PID: $$) ==="
log_info "User: $USER_NAME (UID: $USER_ID), Group: $GROUP_NAME (GID: $GROUP_ID)"
log_info "Command: ffmpeg $*"

log_file INFO \
    "=== $(date): ffmpeg_serviio started ===" \
    "PID: $$" \
    "User: $USER_NAME (UID: $USER_ID)" \
    "Group: $GROUP_NAME (GID: $GROUP_ID)" \
    "Command: ffmpeg $*"

# Проверяем доступ к устройствам VAAPI по группе-владельцу устройства.
# getfacl -d здесь не нужен: у device-нод нет default ACL, парсинг ловил
# заголовок "# group: ..." и работал случайно. При невозможности определить
# группу запуск НЕ блокируем — ffmpeg сам отчитается, если доступа нет.
check_dri_group() {
    local dev grp
    dev="$1"
    if [ ! -e "$dev" ]; then
        log_warning "Device $dev not found — group check skipped"
        log_file INFO "Device $dev not found — group check skipped"
        return 0
    fi
    grp=$(stat -c %G "$dev" 2>/dev/null)
    if [ -z "$grp" ] || [ "$grp" = "?" ]; then
        log_warning "Cannot determine owning group of $dev — group check skipped"
        log_file INFO "Cannot determine group of $dev — group check skipped"
        return 0
    fi
    if id -nG "$USER_NAME" 2>/dev/null | tr ' ' '\n' | grep -qx "$grp"; then
        log_info "User $USER_NAME is a member of group '$grp' ($dev)"
        log_file DEBUG "User: $USER_NAME (UID: $USER_ID) is a member of the group $grp ($dev)"
    else
        log_error "User $USER_NAME is NOT a member of group '$grp' ($dev) — VAAPI access will likely fail"
        log_file INFO "User: $USER_NAME (UID: $USER_ID) is not a member of the group $grp ($dev)!"
        return 1
    fi
}

check_dri_group /dev/dri/renderD128
check_dri_group /dev/dri/card0

# Уникальный ключ кэша: имя файла + хеш(полная команда | размер и mtime источника).
# Разные профили устройств, битрейты и позиции -ss дают разные ключи, а перезапись
# исходника автоматически инвалидирует кэш (раньше ключ был только по имени файла —
# одноимённые файлы из разных каталогов получали чужой контент).
# Функция определена ДО copy-ветки: remux (-c:v copy) тоже кэшируется (v3).
compute_cache_file() {
    local input_basename input_name fingerprint key
    input_basename=$(basename "$1")
    input_name="${input_basename%.*}"
    fingerprint=$(stat -c '%s.%Y' "$1" 2>/dev/null || echo "n/a")
    key=$(printf '%s|%s' "$*" "$fingerprint" | sha256sum | cut -c1-12)
    CACHE_FILE="${CACHE_DIR}/${input_name}-${key}.${OUTPUT_FILE##*.}"
}

# Убедимся, что путь заканчивается на /
if [[ "$SERVIIO_CACHE_DIR" != */ ]]; then
    SERVIIO_CACHE_DIR="$SERVIIO_CACHE_DIR/"
fi

# Проверяем, содержит ли любой из аргументов путь serviio
SERVIIO_OUTPUT=false
OUTPUT_FILE=""
INPUT_FILE=""
HAS_FILTER_COMPLEX=false
FILTER_COMPLEX_VALUE=""
VIDEO_CODEC_IS_COPY=false

# Анализируем аргументы
i=1
while [ $i -le $# ]; do
    arg="${!i}"

    if [[ "$arg" == *"$SERVIIO_CACHE_DIR"* ]]; then
        SERVIIO_OUTPUT=true
        OUTPUT_FILE="$arg"
        log_debug "Detected Serviio output: $OUTPUT_FILE"
    fi

    if [[ "$arg" == "-i" ]] && [ -z "$INPUT_FILE" ]; then
        INPUT_FILE="${@:$((i+1)):1}"
        log_debug "Input file: $INPUT_FILE"
    fi

    if [[ "$arg" == "-filter_complex" ]]; then
        HAS_FILTER_COMPLEX=true
        FILTER_COMPLEX_VALUE="${@:$((i+1)):1}"
        log_debug "Filter complex detected: $FILTER_COMPLEX_VALUE"
    fi

    # ===== НОВОЕ: обнаружение -c:v copy =====
    if [[ "$arg" == "-c:v" ]]; then
        local_next="${@:$((i+1)):1}"
        if [[ "$local_next" == "copy" ]]; then
            VIDEO_CODEC_IS_COPY=true
            log_info "Video codec is COPY (remux only, no transcoding needed)"
        fi
    fi

    ((i++))
done

# ===== если -c:v copy: remux без транскодирования, но С кэшем (v3) =====
if [ "$VIDEO_CODEC_IS_COPY" = true ]; then
    log_info "Stream copy mode — remux without transcoding"
    log_file INFO "=== Stream copy mode (remux) — no transcoding ==="

    # Remux тоже попадает в кэш: повторный просмотр превращает 1-2 минуты
    # работы ffmpeg в простое копирование с локального диска.
    CACHE_FILE=""
    if [ -n "$INPUT_FILE" ] && [ -n "$OUTPUT_FILE" ]; then
        compute_cache_file "$INPUT_FILE" "$@"

        log_debug "Checking cache (remux): $CACHE_FILE"
        log_file DEBUG \
            "=== Checking cache (remux) ===" \
            "Cache file: $CACHE_FILE"

        if [ -f "$CACHE_FILE" ]; then
            log_info "Cache HIT (remux): $CACHE_FILE"
            log_file INFO \
                "=== Cache HIT (remux): File found in cache ===" \
                "Cache file: $CACHE_FILE"
            log_file DEBUG "Copying from cache to: $OUTPUT_FILE"

            if cp "$CACHE_FILE" "$OUTPUT_FILE"; then
                log_info "Successfully restored from cache (remux)"
                log_file INFO "=== Successfully restored from cache (remux) ==="
                log_file DEBUG \
                    "Output file size: $(du -h "$OUTPUT_FILE" | cut -f1)" \
                    "=== Exiting with code 0 ===" \
                    "=== ============================================================== ==="
                exit 0
            else
                rc=$?
                log_error "Failed to copy from cache (remux, exit code: $rc) — remuxing instead"
                log_file INFO \
                    "=== ERROR: Failed to copy from cache (remux) ===" \
                    "Copy command failed with exit code: $rc" \
                    "=== Continuing with remux ==="
            fi
        else
            log_info "Cache MISS (remux) — proceeding with remux"
            log_file INFO \
                "=== Cache MISS (remux): File not found in cache ===" \
                "Proceeding with remux"
        fi
    fi

    log_file DEBUG "=== Starting ffmpeg as-is ==="

    /usr/bin/ffmpeg "$@"
    exit_code=$?

    if [ $exit_code -eq 0 ]; then
        log_info "Stream copy completed successfully"
    else
        log_error "Stream copy failed with exit code: $exit_code"
    fi

    # Успешный remux — атомарно в кэш (те же правила, что и для транскода)
    if [ $exit_code -eq 0 ] && [ -n "$OUTPUT_FILE" ] && [ -f "$OUTPUT_FILE" ] && [ -n "$INPUT_FILE" ]; then
        if [ -z "$CACHE_FILE" ]; then
            compute_cache_file "$INPUT_FILE" "$@"
        fi

        log_file DEBUG \
            "=== Processing cache copy (remux) ===" \
            "Source: $OUTPUT_FILE" \
            "Destination: $CACHE_FILE"

        if [ -f "$CACHE_FILE" ]; then
            log_warning "Cache file already exists (remux): $CACHE_FILE"
            log_file INFO "=== WARNING: Cache file already exists (remux) ==="
            log_file DEBUG "=== Skipping cache copy ==="
        else
            log_info "Copying remuxed file to cache"
            log_file DEBUG "=== Copying remuxed file to cache directory ==="

            tmp_cache="${CACHE_FILE}.tmp.$$"
            if cp "$OUTPUT_FILE" "$tmp_cache" && mv "$tmp_cache" "$CACHE_FILE"; then
                log_info "File successfully copied to cache (remux): $CACHE_FILE"
                log_file INFO \
                    "=== File successfully copied to cache (remux) ===" \
                    "Cache file: $CACHE_FILE"
                log_file DEBUG "File size: $(du -h "$CACHE_FILE" | cut -f1)"
            else
                rc=$?
                rm -f "$tmp_cache"
                log_error "Failed to copy to cache (remux, exit code: $rc)"
                log_file INFO \
                    "=== ERROR: Failed to copy file to cache (remux) ===" \
                    "Copy command failed with exit code: $rc"
            fi
        fi
    fi

    log_file INFO "=== $(date): Stream copy finished with exit code: $exit_code ==="
    log_file DEBUG "=== ============================================================== ==="

    exit $exit_code
fi

if [ "$SERVIIO_OUTPUT" = false ]; then
    log_info "Using standard software transcoding (non-Serviio)"
    log_file INFO "=== Using standard software transcoding ==="
    log_file DEBUG "=== Starting standard ffmpeg ==="

    /usr/bin/ffmpeg "$@"
    exit_code=$?

    if [ $exit_code -eq 0 ]; then
        log_info "Standard ffmpeg finished successfully"
    else
        log_error "Standard ffmpeg failed with exit code: $exit_code"
    fi

    log_file INFO "=== $(date): Standard ffmpeg finished with exit code: $exit_code ==="
    log_file DEBUG "=== =============================================== ==="

    exit $exit_code
fi

log_info "Using hardware acceleration for Serviio transcoding"
log_debug "Input: $INPUT_FILE"
log_debug "Output: $OUTPUT_FILE"
log_debug "Has filter_complex: $HAS_FILTER_COMPLEX"

log_file INFO \
    "=== Using hardware acceleration for Serviio transcoding ===" \
    "Input file: $INPUT_FILE" \
    "Output file: $OUTPUT_FILE" \
    "Has filter_complex (subtitles): $HAS_FILTER_COMPLEX"
log_file DEBUG "Original command: ffmpeg $*"
if [ "$HAS_FILTER_COMPLEX" = true ]; then
    log_file DEBUG "Filter complex value: $FILTER_COMPLEX_VALUE"
fi

# Проверяем наличие файла в кэше перед транскодированием
# (функция compute_cache_file определена выше — до copy-ветки)
CACHE_FILE=""
if [ -n "$INPUT_FILE" ] && [ -n "$OUTPUT_FILE" ]; then
    compute_cache_file "$INPUT_FILE" "$@"

    log_debug "Checking cache: $CACHE_FILE"
    log_file DEBUG \
        "=== Checking cache ===" \
        "Cache file: $CACHE_FILE"

    if [ -f "$CACHE_FILE" ]; then
        log_info "Cache HIT: $CACHE_FILE"
        log_file INFO \
            "=== Cache HIT: File found in cache ===" \
            "Cache file: $CACHE_FILE"
        log_file DEBUG \
            "Copying from cache to: $OUTPUT_FILE" \
            "Cache file size: $(du -h "$CACHE_FILE" | cut -f1)" \
            "Cache file modified: $(stat -c %y "$CACHE_FILE")"

        if cp "$CACHE_FILE" "$OUTPUT_FILE"; then
            log_info "Successfully restored from cache"
            log_file INFO "=== Successfully restored from cache ==="
            log_file DEBUG \
                "Output file size: $(du -h "$OUTPUT_FILE" | cut -f1)" \
                "=== Exiting with code 0 ===" \
                "=== ============================================================== ==="
            exit 0
        else
            rc=$?
            log_error "Failed to copy from cache (exit code: $rc)"
            log_file INFO \
                "=== ERROR: Failed to copy from cache ===" \
                "Copy command failed with exit code: $rc" \
                "=== Continuing with transcoding ==="
        fi
    else
        log_info "Cache MISS — proceeding with transcoding"
        log_file INFO \
            "=== Cache MISS: File not found in cache ===" \
            "Proceeding with transcoding"
    fi
fi

# ====================================================================
# ИСПРАВЛЕНИЕ: build_command теперь заполняет ГЛОБАЛЬНЫЙ МАССИВ
# вместо возврата строки. Это сохраняет пробелы в путях.
# ====================================================================
BUILT_CMD=()

build_command() {
    local mode="$1"
    shift
    BUILT_CMD=()
    local i=1

    while [ $i -le $# ]; do
        local arg="${!i}"

        case "$mode" in
            "hardware_with_subs")
                case "$arg" in
                    "-c:v")
                        BUILT_CMD+=("-vaapi_device" "/dev/dri/renderD128" "-vf" "format=nv12,hwupload" "-c:v" "h264_vaapi")
                        ((i++))
                        ;;
                    "-i")
                        # Аппаратное декодирование БЕЗ -hwaccel_output_format: кадры
                        # автоматически выгружаются в RAM, поэтому программный
                        # -vf format=nv12,hwupload (кейс -c:v ниже) остаётся валидным.
                        # С -hwaccel_output_format vaapi фильтграф падал с
                        # "Impossible to convert between the formats" (exit 218).
                        BUILT_CMD+=("-hwaccel" "vaapi" "-hwaccel_device" "/dev/dri/renderD128" "-i")
                        ;;
                    "-pix_fmt"|"-qscale:v")
                        ((i++))
                        ;;
                    *)
                        BUILT_CMD+=("$arg")
                        ;;
                esac
                ;;

            "hardware_no_subs")
                case "$arg" in
                    "-c:v")
                        BUILT_CMD+=("-vaapi_device" "/dev/dri/renderD128" "-vf" "format=nv12,hwupload" "-c:v" "h264_vaapi")
                        ((i++))
                        ;;
                    "-i")
                        # Аппаратное декодирование БЕЗ -hwaccel_output_format: кадры
                        # автоматически выгружаются в RAM, поэтому программный
                        # -vf format=nv12,hwupload (кейс -c:v ниже) остаётся валидным.
                        # С -hwaccel_output_format vaapi фильтграф падал с
                        # "Impossible to convert between the formats" (exit 218).
                        BUILT_CMD+=("-hwaccel" "vaapi" "-hwaccel_device" "/dev/dri/renderD128" "-i")
                        ;;
                    "-pix_fmt"|"-qscale:v"|"-filter_complex")
                        ((i++))
                        ;;
                    "-map")
                        local next_arg="${@:$((i+1)):1}"
                        if [ "$next_arg" = "[v]" ]; then
                            BUILT_CMD+=("-map" "0:0")
                            ((i++))
                        else
                            BUILT_CMD+=("-map" "$next_arg")
                            ((i++))
                        fi
                        ;;
                    *)
                        BUILT_CMD+=("$arg")
                        ;;
                esac
                ;;

            "software_with_subs")
                case "$arg" in
                    "-c:v")
                        BUILT_CMD+=("-c:v" "libx264" "-preset" "medium" "-crf" "23")
                        ((i++))
                        ;;
                    "-pix_fmt")
                        BUILT_CMD+=("-pix_fmt" "yuv420p")
                        ((i++))
                        ;;
                    *)
                        BUILT_CMD+=("$arg")
                        ;;
                esac
                ;;

            "software_no_subs")
                case "$arg" in
                    "-c:v")
                        BUILT_CMD+=("-c:v" "libx264" "-preset" "medium" "-crf" "23")
                        ((i++))
                        ;;
                    "-pix_fmt")
                        BUILT_CMD+=("-pix_fmt" "yuv420p")
                        ((i++))
                        ;;
                    "-filter_complex")
                        ((i++))
                        ;;
                    "-map")
                        local next_arg="${@:$((i+1)):1}"
                        if [ "$next_arg" = "[v]" ]; then
                            BUILT_CMD+=("-map" "0:0")
                            ((i++))
                        else
                            BUILT_CMD+=("-map" "$next_arg")
                            ((i++))
                        fi
                        ;;
                    *)
                        BUILT_CMD+=("$arg")
                        ;;
                esac
                ;;
        esac

        ((i++))
    done
}

# Функция для запуска команды
run_transcoding() {
    local mode="$1"
    local description="$2"
    shift 2

    log_info "$description (mode: $mode)"
    log_file INFO "=== $description ==="
    log_file DEBUG "Mode: $mode"

    # build_command заполняет глобальный массив BUILT_CMD
    build_command "$mode" "$@"

    # Логируем команду (для читаемости — через строку)
    log_debug "Command: ffmpeg ${BUILT_CMD[*]}"
    log_file DEBUG \
        "Command: ffmpeg ${BUILT_CMD[*]}" \
        "=== Starting transcoding ==="

    # ===== КЛЮЧЕВОЕ ИСПРАВЛЕНИЕ: "${BUILT_CMD[@]}" с кавычками! =====
    # Это сохраняет пробелы в путях к файлам.
    # stderr ffmpeg: при DEBUG — всегда в лог; при INFO — только если уровень
    # упал (прогресс "frame= ..." при успехе в лог не попадает).
    STDERR_TMP="${SCRIPT_LOG}.stderr.$$"
    /usr/bin/ffmpeg "${BUILT_CMD[@]}" 2>"$STDERR_TMP"
    local result=$?

    if [ "$LOG_LEVEL" = "DEBUG" ] || [ $result -ne 0 ]; then
        cat "$STDERR_TMP" >> "$SCRIPT_LOG"
    fi
    rm -f "$STDERR_TMP"

    if [ $result -eq 0 ]; then
        log_info "$description completed successfully"
    else
        log_warning "$description failed with exit code: $result"
    fi

    log_file INFO "=== Finished with exit code: $result ==="

    return $result
}

exit_code=1

# Уровень 1: Аппаратное с субтитрами (если есть субтитры)
if [ "$HAS_FILTER_COMPLEX" = true ]; then
    log_info "LEVEL 1: Trying hardware acceleration WITH subtitles"
    log_file INFO "=== LEVEL 1: Trying hardware acceleration WITH subtitles ==="

    run_transcoding "hardware_with_subs" "Hardware with subtitles" "$@"
    exit_code=$?
fi

# Уровень 2: Аппаратное без субтитров
if [ $exit_code -ne 0 ]; then
    log_info "LEVEL 2: Trying hardware acceleration WITHOUT subtitles"
    log_file INFO "=== LEVEL 2: Trying hardware acceleration WITHOUT subtitles ==="

    run_transcoding "hardware_no_subs" "Hardware without subtitles" "$@"
    exit_code=$?
fi

# Уровень 3: Софтовое с субтитрами (если были субтитры)
if [ $exit_code -ne 0 ] && [ "$HAS_FILTER_COMPLEX" = true ]; then
    log_info "LEVEL 3: Trying software encoding WITH subtitles"
    log_file INFO "=== LEVEL 3: Trying software encoding WITH subtitles ==="

    run_transcoding "software_with_subs" "Software with subtitles" "$@"
    exit_code=$?
fi

# Уровень 4: Софтовое без субтитров
if [ $exit_code -ne 0 ]; then
    log_info "LEVEL 4: Trying software encoding WITHOUT subtitles"
    log_file INFO "=== LEVEL 4: Trying software encoding WITHOUT subtitles ==="

    run_transcoding "software_no_subs" "Software without subtitles" "$@"
    exit_code=$?
fi

# В список обработанных попадают только успешно транскодированные файлы
if [ $exit_code -eq 0 ] && [ -n "$INPUT_FILE" ]; then
    echo "$INPUT_FILE" >> "${LOG_DIR}/transcoding.log"
fi

# Если транскодирование успешно, копируем файл в CACHE_DIR
if [ $exit_code -eq 0 ] && [ -n "$OUTPUT_FILE" ] && [ -f "$OUTPUT_FILE" ]; then
    if [ -z "$CACHE_FILE" ] && [ -n "$INPUT_FILE" ]; then
        compute_cache_file "$INPUT_FILE" "$@"
    elif [ -z "$CACHE_FILE" ]; then
        CACHE_FILE="${CACHE_DIR}/$(basename "$OUTPUT_FILE")"
    fi

    log_debug "Processing cache copy: $OUTPUT_FILE -> $CACHE_FILE"
    log_file DEBUG \
        "=== Processing cache copy ===" \
        "Source: $OUTPUT_FILE" \
        "Destination: $CACHE_FILE"

    if [ -f "$CACHE_FILE" ]; then
        log_warning "Cache file already exists: $CACHE_FILE"
        log_file INFO "=== WARNING: Cache file already exists ==="
        log_file DEBUG \
            "Existing file: $CACHE_FILE" \
            "Size: $(du -h "$CACHE_FILE" | cut -f1)" \
            "Modified: $(stat -c %y "$CACHE_FILE")" \
            "=== Skipping cache copy ==="
    else
        log_info "Copying transcoded file to cache"
        log_file DEBUG "=== Copying transcoded file to cache directory ==="

        # Атомарная запись: сперва во временный файл, затем mv внутри той же ФС.
        # Убитый посреди копирования процесс не оставит битый файл в кэше.
        tmp_cache="${CACHE_FILE}.tmp.$$"
        if cp "$OUTPUT_FILE" "$tmp_cache" && mv "$tmp_cache" "$CACHE_FILE"; then
            log_info "File successfully copied to cache: $CACHE_FILE"
            log_file INFO \
                "=== File successfully copied to cache ===" \
                "Cache file: $CACHE_FILE"
            log_file DEBUG "File size: $(du -h "$CACHE_FILE" | cut -f1)"
        else
            rc=$?
            rm -f "$tmp_cache"
            log_error "Failed to copy to cache (exit code: $rc)"
            log_file INFO \
                "=== ERROR: Failed to copy file to cache ===" \
                "Copy command failed with exit code: $rc"
        fi
    fi
else
    if [ $exit_code -ne 0 ]; then
        log_error "Skipping cache copy — transcoding failed (exit code: $exit_code)"
    elif [ ! -f "$OUTPUT_FILE" ]; then
        log_warning "Skipping cache copy — output file not found: $OUTPUT_FILE"
    else
        log_debug "Skipping cache copy — output file path not detected"
    fi

    log_file INFO "=== Skipping cache copy ==="
    if [ $exit_code -ne 0 ]; then
        log_file INFO "Reason: Transcoding failed (exit code: $exit_code)"
    elif [ ! -f "$OUTPUT_FILE" ]; then
        log_file INFO "Reason: Output file not found: $OUTPUT_FILE"
    else
        log_file INFO "Reason: Output file path not detected"
    fi
fi

if [ $exit_code -eq 0 ]; then
    log_info "=== ffmpeg_serviio completed successfully ==="
else
    log_error "=== ffmpeg_serviio failed with exit code: $exit_code ==="
fi

log_file INFO "=== $(date): ffmpeg_serviio finished with exit code: $exit_code ==="
log_file DEBUG "=== ============================================================== ==="

exit $exit_code
